# Server Configuration
PORT=3000
DOMAIN=http://localhost:3000
NODE_ENV=development

# JWT Secret (change this to something random)
JWT_SECRET=your-super-secret-jwt-key-change-me-in-production

# MongoDB Connection String
MONGODB_URI=mongodb+srv://username:password@cluster0.mongodb.net/obfuscator?retryWrites=true&w=majority

# Email Configuration (Gmail example)
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-specific-password
EMAIL_FROM=Obfuscator <your-email@gmail.com>

# Stripe Configuration
# Get these from https://dashboard.stripe.com/apikeys
STRIPE_SECRET=sk_test_YOUR_SECRET_KEY_HERE
STRIPE_WEBHOOK_SECRET=whsec_YOUR_WEBHOOK_SECRET_HERE

# Stripe Plan Price IDs
# Create these in Stripe Dashboard > Products
# Format: price_xxxxx
STRIPE_PRICE_PROFESSIONAL=price_REPLACE_WITH_YOUR_PROFESSIONAL_PRICE_ID
STRIPE_PRICE_ENTERPRISE=price_REPLACE_WITH_YOUR_ENTERPRISE_PRICE_ID
