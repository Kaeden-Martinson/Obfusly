# Copy this file to .env and fill in your own values.
# .env is gitignored and must never be committed.

# Database: "local" runs an embedded MongoDB (data in .localdb/),
# or set a real connection string, e.g. mongodb+srv://user:pass@cluster.mongodb.net/
MONGO_URI=local

# ============================================================================
# AUTHENTICATION
# ============================================================================
JWT_SECRET="change-me-to-a-long-random-string"

# ============================================================================
# STRIPE CONFIGURATION
# ============================================================================

STRIPE_RESTRICTED_KEY="rk_live_or_rk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Price IDs from Stripe Dashboard
STRIPE_PRICE_PROFESSIONAL="price_..."
STRIPE_PRICE_ENTERPRISE="price_..."

# ============================================================================
# SERVER CONFIGURATION
# ============================================================================
PORT=3001
NODE_ENV="development"
DOMAIN="http://localhost:3001"

EMAIL_PROVIDER=gmail

# For Gmail (requires an App Password, not your regular password)
EMAIL_USER="you@example.com"
EMAIL_PASSWORD="your-gmail-app-password"
